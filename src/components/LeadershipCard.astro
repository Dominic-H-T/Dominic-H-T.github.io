---
// LeadershipCard.astro
interface Props {
  organization: string;
  role: string;
  period: string;
  focusArea: string;
  achievements: string[];
  link?: string;
  featured?: boolean;
}

const { organization, role, period, focusArea, achievements, link, featured } = Astro.props;
---

<article 
  data-category="leadership" 
  class="portfolio-card relative bg-cyber-panel border border-cyber-border hover:border-cyber-yellow transition-all duration-300 p-6 chamfer-md group flex flex-col justify-between hover:shadow-glow-yellow"
>
  <div>
    <!-- Leadership Header -->
    <div class="flex items-center justify-between font-mono text-[11px] text-cyber-textMuted border-b border-cyber-border/70 pb-3 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-cyber-yellow font-bold">&gt; ORG_DISPATCH:</span>
        <span class="text-cyber-textMain">{period}</span>
      </div>
      {featured && (
        <span class="px-2 py-0.5 bg-cyber-yellow/15 text-cyber-yellow border border-cyber-yellow/40 text-[10px] chamfer-sm font-bold">
          [LEAD_OFFICER]
        </span>
      )}
    </div>

    <!-- Org & Role -->
    <h3 class="text-xl font-bold font-mono text-cyber-textMain group-hover:text-cyber-yellow transition-colors mb-1">
      {organization}
    </h3>
    <div class="font-mono text-xs text-cyber-yellow mb-3 font-semibold">
      ROLE: {role}
    </div>

    <!-- Focus Area -->
    <div class="text-cyber-textMuted text-xs font-mono mb-4 border-l-2 border-cyber-yellow/60 pl-2">
      // CORE_FOCUS: {focusArea}
    </div>

    <!-- Achievements Checklist -->
    <div class="space-y-2 mb-6">
      {achievements.map(item => (
        <div class="text-sm text-cyber-textMain flex items-start gap-2.5">
          <span class="text-cyber-yellow font-mono mt-0.5">&gt;&gt;</span>
          <span class="leading-relaxed">{item}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Action Links Footer -->
  <div class="pt-4 border-t border-cyber-border/60 flex items-center justify-between font-mono text-xs">
    <span class="text-cyber-textMuted text-[11px]">[GOVERNANCE: VERIFIED]</span>
    {link && (
      <a 
        href={link} 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-cyber-yellow hover:text-white transition-colors flex items-center gap-1 hover:underline"
      >
        <span>[ORG_PORTAL &nearr;]</span>
      </a>
    )}
  </div>
</article>
