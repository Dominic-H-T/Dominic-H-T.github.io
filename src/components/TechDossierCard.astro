---
// TechDossierCard.astro
interface Props {
  title: string;
  summary: string;
  date: string;
  language: string;
  role?: string;
  tags: string[];
  mitreTags?: string[];
  github?: string;
  demo?: string;
  notPubliclyShared?: boolean;
  status: string;
  featured?: boolean;
}

const { title, summary, date, language, role = "Major Developer", tags, mitreTags, github, demo, notPubliclyShared, status, featured } = Astro.props;
const isRedacted = title.includes('REDACTED');
---

<article 
  data-category="tech" 
  class={`portfolio-card relative bg-cyber-panel border ${isRedacted ? 'border-red-500/40 hover:border-red-500 hover:shadow-[0_0_15px_rgba(239,68,68,0.35)]' : 'border-cyber-border hover:border-cyber-cyan hover:shadow-glow-cyan'} transition-all duration-300 p-6 chamfer-md group flex flex-col justify-between`}
>
  <div>
    <!-- Dossier Header Bar (Uncluttered) -->
    <div class="flex items-center justify-between font-mono text-[11px] text-cyber-textMuted border-b border-cyber-border/70 pb-2.5 mb-3.5 gap-2">
      <div class="flex items-center gap-1.5">
        <span class={isRedacted ? "text-red-400 font-bold" : "text-cyber-cyan font-bold"}>&gt; DOSSIER:</span>
        <span class="text-cyber-textMuted tracking-wider">SYS_SPEC</span>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        {isRedacted ? (
          <span class="px-2 py-0.5 bg-red-500/20 text-red-400 border border-red-500/50 text-[10px] chamfer-sm font-bold tracking-wider animate-pulse">
            [REDACTED]
          </span>
        ) : featured && (
          <span class="px-2 py-0.5 bg-cyber-cyan/15 text-cyber-cyan border border-cyber-cyan/40 text-[10px] chamfer-sm font-bold">
            [FEATURED]
          </span>
        )}
        <span class={isRedacted ? "text-red-400" : "text-cyber-green"}>[{status.toUpperCase()}]</span>
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold font-mono text-cyber-textMain group-hover:text-cyber-cyan transition-colors mb-2 leading-tight">
      {title}
    </h3>

    <!-- Role & Core Tech Sub-Header (Moved here to eliminate header crowding) -->
    <div class="flex flex-wrap items-center gap-2 mb-3.5 font-mono text-xs">
      <div class="px-2.5 py-0.5 bg-cyber-carbon border border-cyber-cyan/40 text-cyber-cyan chamfer-sm text-[11px]">
        ROLE: <span class="font-bold text-white">{role}</span>
      </div>
      <div class="px-2.5 py-0.5 bg-cyber-carbon border border-cyber-border text-cyber-textMuted chamfer-sm text-[11px]">
        STACK: <span class="text-cyber-textMain">{language}</span>
      </div>
    </div>

    <!-- Summary -->
    <p class="text-cyber-textMuted text-sm leading-relaxed mb-4">
      {summary}
    </p>

    <!-- MITRE ATT&CK Tags -->
    {mitreTags && mitreTags.length > 0 && (
      <div class="mb-4">
        <div class="font-mono text-[10px] text-cyber-yellow tracking-wider mb-1.5">// MITRE ATT&CK RECON:</div>
        <div class="flex flex-wrap gap-1.5">
          {mitreTags.map(tag => (
            <span class="font-mono text-[10px] px-2 py-0.5 bg-cyber-yellow/10 border border-cyber-yellow/30 text-cyber-yellow chamfer-sm">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {tags.map(tag => (
        <span class="font-mono text-[11px] px-2 py-0.5 bg-cyber-carbon border border-cyber-border text-cyber-cyan chamfer-sm">
          #{tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Action Links Footer -->
  <div class="pt-4 border-t border-cyber-border/60 flex items-center justify-between font-mono text-xs">
    <span class="text-cyber-textMuted text-[11px]">{date}</span>
    <div class="flex items-center gap-3">
      {isRedacted ? (
        <div class="flex items-center gap-2">
          <span class="text-red-400 font-mono text-[10px] hidden sm:inline">[ACCESS_RESTRICTED]</span>
          {github && (
            <a 
              href={github} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-red-400 hover:text-white transition-colors flex items-center gap-1 hover:underline font-mono text-xs"
            >
              <span>[PRIVATE_ORG &nearr;]</span>
            </a>
          )}
        </div>
      ) : (
        <>
          {notPubliclyShared || !github ? (
            <span class="text-cyber-yellow/80 font-mono text-[11px] border border-cyber-yellow/30 px-2 py-0.5 chamfer-sm bg-cyber-yellow/5">
              [NOT PUBLICLY SHARED]
            </span>
          ) : (
            <a 
              href={github} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-cyber-cyan hover:text-white transition-colors flex items-center gap-1 hover:underline font-mono text-xs"
            >
              <span>[SOURCE_CODE &nearr;]</span>
            </a>
          )}
          {demo && (
            <a 
              href={demo} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-cyber-green hover:text-white transition-colors flex items-center gap-1 hover:underline font-mono text-xs"
            >
              <span>[LIVE_DEMO &nearr;]</span>
            </a>
          )}
        </>
      )}
    </div>
  </div>
</article>
