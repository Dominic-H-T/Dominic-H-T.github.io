---
// FooterStatus.astro
---

<footer class="w-full border-t border-cyber-border bg-cyber-carbon/90 mt-20 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 pb-8 border-b border-cyber-border/60">
      
      <!-- Bio / Operator Dossier -->
      <div>
        <div class="font-mono text-xs text-cyber-cyan tracking-wider mb-2 font-bold">
          // OPERATOR_PROFILE
        </div>
        <p class="text-xs text-cyber-textMuted leading-relaxed">
          Dominic Hatcher-Thomassen &bull; CS & Communication at Seattle Pacific University (SPU). 
          Engineering resilient systems, threat intelligence, and cinematic narratives.
        </p>
      </div>

      <!-- Deployment Telemetry -->
      <div>
        <div class="font-mono text-xs text-cyber-yellow tracking-wider mb-2 font-bold">
          // HOSTING_LIFECYCLE
        </div>
        <div class="font-mono text-xs space-y-1 text-cyber-textMuted">
          <div>STAGE 1: <span class="text-cyber-green">[ACTIVE: GITHUB_PAGES]</span></div>
          <div>STAGE 2: <span class="text-cyber-yellow">[SCHEDULED: CLOUDFLARE_2028]</span></div>
          <div>STACK: <span class="text-cyber-cyan">Astro 4 &bull; Tailwind &bull; TypeScript</span></div>
        </div>
      </div>

      <!-- Transmission Channels -->
      <div>
        <div class="font-mono text-xs text-cyber-magenta tracking-wider mb-2 font-bold">
          // TRANSMISSION_CHANNELS
        </div>
        <div class="flex flex-col space-y-1.5 font-mono text-xs">
          <a 
            href="mailto:contact@dominic.dev" 
            class="text-cyber-textMain hover:text-cyber-cyan transition-colors flex items-center gap-2"
          >
            <span class="text-cyber-cyan">&gt;</span> EMAIL: contact@dominic.dev
          </a>
          <a 
            href="https://github.com/Dominic-H-T" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-cyber-textMain hover:text-cyber-cyan transition-colors flex items-center gap-2"
          >
            <span class="text-cyber-cyan">&gt;</span> GITHUB: @Dominic-H-T
          </a>
          <a 
            href="https://github.com/WaaaaayTwoManyHats" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-cyber-textMuted hover:text-cyber-cyan transition-colors flex items-center gap-2 text-[11px]"
          >
            <span class="text-cyber-cyan">&bull;</span> ORG: WaaaaayTwoManyHats
          </a>
          <a 
            href="https://github.com/Lefihm" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-cyber-textMuted hover:text-red-400 transition-colors flex items-center gap-2 text-[11px]"
          >
            <span class="text-red-400">&bull;</span> ORG: Lefihm [STEALTH]
          </a>
          <a 
            href="https://www.linkedin.com/in/dominichatcher/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-cyber-textMain hover:text-cyber-magenta transition-colors flex items-center gap-2"
          >
            <span class="text-cyber-magenta">&gt;</span> LINKEDIN: Dominic Hatcher-Thomassen
          </a>
        </div>
      </div>

    </div>

    <!-- Copyright / Terminal Hash -->
    <div class="flex flex-wrap items-center justify-between font-mono text-[11px] text-cyber-textMuted gap-4">
      <div>
        &copy; {new Date().getFullYear()} DOMINIC HATCHER-THOMASSEN // ALL RIGHTS RESERVED
      </div>
      <div class="flex items-center gap-3">
        <span class="text-cyber-green">&bull; STATUS: ALL_SYSTEMS_NOMINAL</span>
        <span>BUILD_REV: #2026.11.09</span>
      </div>
    </div>
  </div>
</footer>
